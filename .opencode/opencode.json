{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "cargo publish *": "deny",
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf .git/*": "deny",
      "curl * | sh": "deny",
      "wget * | bash": "deny"
    },
    "edit": {
      "*": "allow",
      ".env*": "ask",
      ".git/**/*": "deny"
    }
  }
}
